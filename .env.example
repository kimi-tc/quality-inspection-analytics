# DeepSeek API key for server-side AI analysis.
# Keep this value on the server only. Do not expose it to the browser.
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY"

# Optional. Defaults are shown below.
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Optional deployment settings.
PORT=3000
DATA_DIR="/opt/quality-inspection-analytics/data"

# Optional unified data service.
# Leave empty on ECS so ECS reads and writes its own data directory.
# Set this on local development and Mac mini to make all three environments
# share the ECS quality dataset, efficiency dataset, dictionary, and import history.
SHARED_DATA_API_BASE_URL=""
SHARED_DATA_API_TIMEOUT_MS=120000
