-- ==========================================
-- 输出每个员工的明细数据
-- 日期范围：{{START_DATE}} 至 {{END_DATE}}
-- ==========================================
SELECT
    report_date AS `日期`,
    observer_name AS `员工姓名`,
    CASE
        WHEN observer_name IN ('李海鹏','朱熹航','杨鹏','乐越辉','赵敏','徐鑫杰','周超','候伟强','滕济灿') THEN '常州_老人'
        WHEN observer_name IN ('沈轶','刘付强','李英蕾','薛航天','马梦依') THEN '上海_第一批'
        WHEN observer_name IN ('潘姝羽','李蓓','朱桂丽') THEN '常州_新人'
        WHEN observer_name IN ('沈维维','徐瑞倩','顾月','李梦玮','金晨','范钰硕','沈丰','侯帅威','陶懿酩') THEN '上海_第二批'
        WHEN observer_name IN ('贺然','黄美林','张雪','陈佳蕊','任敏') THEN '上海_第三批'
        ELSE '其他'
    END AS `团队`,
    CAST(SUM(appeal_audit_cnt) + SUM(audit_cnt) AS BIGINT) AS `总审核量`,
    CAST(SUM(weighted_audit_cnt) AS DOUBLE) AS `加权审核量`,
    CAST(SUM(audit_cnt) AS BIGINT) AS `一审审核量`,
    CAST(SUM(audit_pass_cnt) AS BIGINT) AS `一审通过量`,
    CAST(SUM(audit_pass_cnt) / NULLIF(SUM(audit_cnt), 0) AS DOUBLE) AS `通过率`,
    CAST(SUM(audit_pass_cnt) - SUM(ambiguous_cnt) AS BIGINT) AS `精准通过量`,
    CAST((SUM(audit_pass_cnt) - SUM(ambiguous_cnt)) / NULLIF(SUM(audit_cnt), 0) AS DOUBLE) AS `精准通过率`,
    CAST(SUM(audit_cnt) - SUM(audit_pass_cnt) AS BIGINT) AS `未通过量`,
    CAST(SUM(proof_refusal) AS BIGINT) AS `举证拒绝量`,
    CAST(SUM(ambiguous_cnt) AS BIGINT) AS `模糊通过量`,
    CAST(1 - ((SUM(ambiguous_cnt) + SUM(proof_refusal)) / NULLIF(SUM(audit_cnt), 0)) AS DOUBLE) AS `举证准确率`
FROM (
    -- 1. 一审人工审核数据
    SELECT
        DATE(asa.online1_complete_dt) AS report_date,
        asa.online1_observer_name AS observer_name,
        COUNT(DISTINCT IF(asa.online1_result_name IS NOT NULL, asa.return_order_no, NULL)) AS audit_cnt,
        COUNT(DISTINCT IF(asa.online1_result_name = '审核通过', asa.return_order_no, NULL)) AS audit_pass_cnt,
        COUNT(DISTINCT IF(asa.online1_result_name = '审核未通过' AND asa.online1_remark_txt LIKE '%举证%', asa.return_order_no, NULL)) AS proof_refusal,
        COUNT(DISTINCT IF(asa.online1_result_name = '审核通过' AND asa.online1_diff_name_names = '', asa.return_order_no, NULL)) AS ambiguous_cnt,
        0 AS appeal_audit_cnt,
        SUM(
            CASE
                WHEN asa.online1_result_name IS NOT NULL
                 AND asa.online1_diff_name_names = asa_e.oneline1_property_names
                 AND INSTR(asa_e.oneline1_property_names, CHR(59)) = 0
                 AND asa_e.oneline1_property_names IN (
                    '售后案例情况', '主板维修情况', '屏幕维修情况', '电池维修情况',
                    '后壳维修情况', '零件维修情况', '摄像头维修', '受潮状况', '整机风险项'
                 ) THEN 1.1
                WHEN asa.online1_result_name IS NOT NULL
                 AND asa.online1_diff_name_names = asa_e.oneline1_property_names
                 AND INSTR(asa_e.oneline1_property_names, CHR(59)) = 0
                 AND asa_e.oneline1_property_names IN ('屏幕外观', '边框背板', '机身弯曲') THEN 0.8
                WHEN asa.online1_result_name IS NOT NULL
                 AND (
                    INSTR(asa_e.oneline1_property_names, CHR(59)) > 0
                    OR INSTR(asa.online1_diff_name_names, CHR(59)) > 0
                    OR asa.online1_diff_name_names != asa_e.oneline1_property_names
                 ) THEN 1.2
                ELSE 1
            END
        ) AS weighted_audit_cnt
    FROM dm.dm_centre_return_after_sale_analysis asa
    JOIN dm.dm_centre_return_after_sale_analysis_ext asa_e
        ON asa.return_order_no = asa_e.return_order_no
       AND asa.product_no = asa_e.product_no
    WHERE DATE(asa.online1_complete_dt) BETWEEN '{{START_DATE}}' AND '{{END_DATE}}'
      AND asa.online1_observer_id <> 0
      AND asa.online1_observer_id IS NOT NULL
    GROUP BY DATE(asa.online1_complete_dt), asa.online1_observer_name

    UNION ALL

    -- 2. 二审(申诉)人工审核数据
    SELECT
        DATE(asa.online2_complete_dt) AS report_date,
        asa.online2_observer_name AS observer_name,
        0 AS audit_cnt,
        0 AS audit_pass_cnt,
        0 AS proof_refusal,
        0 AS ambiguous_cnt,
        COUNT(DISTINCT IF(asa.online2_result_name IS NOT NULL, asa.return_order_no, NULL)) AS appeal_audit_cnt,
        SUM(
            CASE
                WHEN asa.online2_result_name IS NOT NULL
                 AND asa.online2_diff_name_names = asa_e.oneline2_property_names
                 AND INSTR(asa_e.oneline2_property_names, CHR(59)) = 0
                 AND asa_e.oneline2_property_names IN (
                    '售后案例情况', '主板维修情况', '屏幕维修情况', '电池维修情况',
                    '后壳维修情况', '零件维修情况', '摄像头维修', '受潮状况', '整机风险项'
                 ) THEN 1.1
                WHEN asa.online2_result_name IS NOT NULL
                 AND asa.online2_diff_name_names = asa_e.oneline2_property_names
                 AND INSTR(asa_e.oneline2_property_names, CHR(59)) = 0
                 AND asa_e.oneline2_property_names IN ('屏幕外观', '边框背板', '机身弯曲') THEN 0.8
                WHEN asa.online2_result_name IS NOT NULL
                 AND (
                    INSTR(asa_e.oneline2_property_names, CHR(59)) > 0
                    OR INSTR(asa.online2_diff_name_names, CHR(59)) > 0
                    OR asa.online2_diff_name_names != asa_e.oneline2_property_names
                 ) THEN 1.2
                ELSE 1
            END
        ) AS weighted_audit_cnt
    FROM dm.dm_centre_return_after_sale_analysis asa
    JOIN dm.dm_centre_return_after_sale_analysis_ext asa_e
        ON asa.return_order_no = asa_e.return_order_no
       AND asa.product_no = asa_e.product_no
    WHERE DATE(asa.online2_complete_dt) BETWEEN '{{START_DATE}}' AND '{{END_DATE}}'
      AND asa.online2_observer_id <> 0
      AND asa.online2_observer_id IS NOT NULL
    GROUP BY DATE(asa.online2_complete_dt), asa.online2_observer_name
) t1
WHERE observer_name <> '系统'
  AND observer_name IS NOT NULL
GROUP BY
    report_date,
    observer_name,
    CASE
        WHEN observer_name IN ('李海鹏','朱熹航','杨鹏','乐越辉','赵敏','徐鑫杰','周超','候伟强','滕济灿') THEN '常州_老人'
        WHEN observer_name IN ('沈轶','刘付强','李英蕾','薛航天','马梦依') THEN '上海_第一批'
        WHEN observer_name IN ('潘姝羽','李蓓','朱桂丽') THEN '常州_新人'
        WHEN observer_name IN ('沈维维','徐瑞倩','顾月','李梦玮','金晨','范钰硕','沈丰','侯帅威','陶懿酩') THEN '上海_第二批'
        WHEN observer_name IN ('贺然','黄美林','张雪','陈佳蕊','任敏') THEN '上海_第三批'
        ELSE '其他'
    END
ORDER BY
    report_date,
    `团队`,
    `员工姓名`;
