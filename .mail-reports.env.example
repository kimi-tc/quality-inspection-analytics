FEISHU_IMAP_HOST=imap.feishu.cn
FEISHU_IMAP_PORT=993
FEISHU_IMAP_SECURE=1
FEISHU_EMAIL=your-email@example.com
FEISHU_EMAIL_AUTH_CODE=
FEISHU_IMAP_MAILBOX=INBOX

MAIL_REPORT_QUALITY_SUBJECT=看板_基础数据
MAIL_REPORT_EFFICIENCY_SUBJECT=看板_人效
MAIL_REPORT_LOOKBACK_DAYS=3
MAIL_REPORT_DOWNLOAD_DIR=/Users/your-user/Downloads/预质检每日数据

# 使用 macOS 邮件.app 时可选。留空时默认读取 Mail 的 INBOX。
APPLE_MAILBOX_NAME=
APPLE_MAIL_ACCOUNT_NAME=

# 默认只导入 Mac mini 本地服务；如需同时同步 ECS，用 npm run mail:import:sync。
MAIL_REPORT_SYNC_TO_ECS=0

# 每日预警飞书机器人。配置后可运行 npm run alert:daily:push。
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
ALERT_API_BASE_URL=http://127.0.0.1:3000
